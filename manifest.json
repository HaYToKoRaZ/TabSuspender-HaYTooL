{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.8",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "homepage_url": "https://haytokoraz.github.io/TabSuspender-HaYTooL/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "commands": {
    "suspend-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "__MSG_commandSuspendCurrent__"
    },
    "suspend-all-tabs": {
      "description": "__MSG_commandSuspendAll__"
    },
    "suspend-all-but-current-tab": {
      "description": "__MSG_commandSuspendOthers__"
    },
    "unsuspend-all-tabs": {
      "description": "__MSG_commandUnsuspendAll__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [ "suspended.html", "animals/*.svg" ],
      "matches": [ "<all_urls>" ]
    }
  ]
}
